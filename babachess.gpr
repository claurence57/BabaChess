--
--  BabaChess : a bitboard chess engine written in Ada 2012.
--
--  BabaChess is a FORK of AdaChess (https://github.com/adachess/AdaChess),
--  derived from its bitboard engine ("BB", sources src/, packages
--  BBChess.*). This project is the sole development target; the original
--  mailbox engine is not carried over.
--
--  Licence: GPL-3.0-or-later (see LICENSE), except the C components reused
--  under MIT (src/fathom/ Syzygy probe and its stdendian.h; see
--  src/fathom/LICENSE).
--

project BabaChess is

   for Main use ("babachess.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Dirs use ("src/**");
   for Languages use ("Ada", "C");

   type Mode_Type is
      ("release", "debug", "portable", "checked");
   Mode : Mode_Type := external ("Mode", "release");

   --  Extra CPU/ISA switches, injected by the Makefile (e.g. "-march=native"
   --  or a detected set such as "-mavx2 -mfma -mlzcnt -madx"). Split on
   --  spaces by external_as_list so each switch is a separate argument.
   --  Empty by default: a plain "gprbuild -P babachess.gpr" is unchanged.
   Arch_Switches := External_As_List ("BABA_ARCH_FLAGS", " ");

   package Builder is
      for Default_Switches ("ada") use ("-g");
      for Executable ("babachess.adb") use "babachess";
   end Builder;

   package Compiler is
      --  Integrated Ada preprocessing (-gnatep): a few sources choose an
      --  implementation with #if REL / #else. prep.data lives in src and
      --  is referenced from obj (the -gnatep path is resolved relative to
      --  the object directory). The "release" build defines REL so PEXT is
      --  inlined as a BMI2 intrinsic; "portable" leaves it undefined (the
      --  data file passes -u) and uses the C shim's software fallback.
      case Mode is
         when "release" =>
            for Switches ("ada") use
              ("-gnat2012", "-gnatp", "-gnatN", "-O3", "-gnatf",
               "-gnatep=../src/prep.data", "-gnateDREL",
               "-mpopcnt", "-mbmi", "-mbmi2", "-flto") & Arch_Switches;
            --  No -flto on the C side: gprbuild archives the C objects with
            --  "ar" and links libbabachess.a, and the standard (FSF) gprbuild
            --  ships a "gcc-ar" that is not used here, so an LTO bytecode
            --  archive fails the link ("lto1: bytecode stream ... generated
            --  with LTO version ..."). The C is not on the hot path in
            --  release (PEXT is the inlined BMI2 intrinsic; the C left is the
            --  Fathom wrapper and the portable PEXT shim), so dropping -flto
            --  here costs nothing measurable.
            for Switches ("c") use
              ("-O3", "-mpopcnt", "-mbmi", "-mbmi2") & Arch_Switches;
          when "debug" =>
            --  -gnatwa enables all warnings; the debug build is the only one
            --  that carries them (release/portable stay quiet and fast).
            --  -gnatyy enables the GNAT style checks (indentation, spacing,
            --  casing, ...): the style is already consistent, so the build
            --  stays warning-free and CI catches any drift.
            for Switches ("ada") use
              ("-gnat2012", "-gnata", "-g", "-gnatwa", "-gnatVa", "-gnatyy",
               "-gnatep=../src/prep.data") & Arch_Switches;
            for Switches ("c") use ("-O0", "-g") & Arch_Switches;
         when "portable" =>
            --  No -mpopcnt/-mbmi/-mbmi2: runs on any x86-64 CPU, using the
            --  software PEXT fallback in bbchess-bits.c (~25% slower).
            for Switches ("ada") use
              ("-gnat2012", "-gnatp", "-gnatN", "-O3", "-gnatf",
               "-gnatep=../src/prep.data") & Arch_Switches;
            for Switches ("c") use ("-O3") & Arch_Switches;
         when "checked" =>
            --  "release" speed (-O3, -gnatN, -flto) with the run-time checks
            --  kept ON (-gnata, no -gnatp): assertions, range and index
            --  checks are active. Slower but defined behaviour, so this is
            --  the mode for long SPRT campaigns; "release" is for
            --  distribution. Same ISA switches and preprocessing as release.
            for Switches ("ada") use
              ("-gnat2012", "-gnata", "-gnatN", "-O3", "-gnatf",
               "-gnatep=../src/prep.data", "-gnateDREL",
               "-mpopcnt", "-mbmi", "-mbmi2", "-flto") & Arch_Switches;
            for Switches ("c") use
              ("-O3", "-mpopcnt", "-mbmi", "-mbmi2") & Arch_Switches;
      end case;
   end Compiler;

   package Linker is
      for Switches ("ada") use ("-g");
   end Linker;

end BabaChess;
